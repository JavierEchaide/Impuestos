# Copia este archivo a .env y rellena los valores. .env NO se sube al repositorio.

# Postgres (en Vercel, la integración de Neon inyecta estas variables)
DATABASE_URL=postgres://postgres@localhost:5432/cuentas
# Conexión directa (sin pooler) para migraciones. Opcional: si falta se usa DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Secreto de Better Auth (mínimo 32 caracteres). Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL pública de la app. En local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
